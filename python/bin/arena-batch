#!/usr/bin/env python3
import sys
import os

# Garante que o diretório raiz do repositório está no sys.path
repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
if repo_root not in sys.path:
    sys.path.insert(0, repo_root)

from python.arena_batch import main

if __name__ == "__main__":
    sys.exit(main())
